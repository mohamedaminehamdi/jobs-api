{
  "name": "jobs-api",
  "version": "1.0.0",
  "description": "REST API for tracking job applications, with JWT authentication and MongoDB",
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "rest-api",
    "jobs"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node populate.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "author": "Mohamed Amine Hamdi",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.2.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.4.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.13",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^4.1.6",
    "xss-clean": "^0.1.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^6.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedaminehamdi/Jobs-Api.git"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!coverage/**",
      "!tests/**",
      "!server.js"
    ]
  }
}
